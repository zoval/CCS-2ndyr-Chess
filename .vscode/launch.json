{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run CCS Chess with JavaFX",
            "request": "launch",
            "mainClass": "com.ccs.chess.ui.ChessApplication",
            "vmArgs": "--module-path \"${env:USERPROFILE}/.m2/repository/org/openjfx/javafx-base/21.0.4/javafx-base-21.0.4.jar;${env:USERPROFILE}/.m2/repository/org/openjfx/javafx-graphics/21.0.4/javafx-graphics-21.0.4.jar;${env:USERPROFILE}/.m2/repository/org/openjfx/javafx-controls/21.0.4/javafx-controls-21.0.4.jar;${env:USERPROFILE}/.m2/repository/org/openjfx/javafx-base/21.0.4/javafx-base-21.0.4-win.jar;${env:USERPROFILE}/.m2/repository/org/openjfx/javafx-graphics/21.0.4/javafx-graphics-21.0.4-win.jar;${env:USERPROFILE}/.m2/repository/org/openjfx/javafx-controls/21.0.4/javafx-controls-21.0.4-win.jar\" --add-modules javafx.controls --enable-native-access=javafx.graphics"
        }
    ]
}